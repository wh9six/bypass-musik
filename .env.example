PORT=8787
ROBLOX_API_KEY=
ROBLOX_CREATOR_USER_ID=
# ROBLOX_CREATOR_GROUP_ID=

MAX_AUDIO_BYTES=83886080
MAX_AUDIO_SECONDS=420
REQUEST_TIMEOUT_MS=45000

# Login web
# User: login cukup username, tanpa password.
# Admin: pakai kode di bawah untuk memantau upload user dan mengatur API key Roblox.
ADMIN_CODE=ganti-kode-admin-ini
AUTH_SESSION_TTL_MS=2592000000
AUTH_SESSIONS_FILE=./auth-sessions.json
AUTH_USERS_FILE=./auth-users.json

# Pengaturan nama sound / PlaybackSpeed / folder Studio yang dipakai semua user
STUDIO_SETTINGS_FILE=./studio-settings.json

YTDL_COOKIES_JSON=
YTDL_COOKIES_FILE=./cookies.json
YTDLP_COOKIES_FROM_BROWSER=chrome

# yt-dlp dipakai sebagai cadangan kalau ytdl-core gagal. Binary standalone (tanpa Python)
# otomatis diunduh npm install ke folder bin/ lewat scripts/fetch-yt-dlp.mjs.
# Isi hanya kalau mau pakai yt-dlp sendiri:
# YTDLP_BINARY=/jalan/ke/yt-dlp
# YTDLP_ASSET=yt-dlp_linux   # pilihan lain: yt-dlp_musllinux, yt-dlp.exe, yt-dlp_macos

# Player YouTube yang dicoba yt-dlp. "auto" (default) berarti yt-dlp pilih sendiri,
# lalu otomatis mencoba web_safari -> mweb -> web_embedded kalau ditolak YouTube.
# Isi manual hanya kalau server terus kena bot-check, misalnya:
# YTDLP_PLAYER_CLIENT=web_safari

# ytdl-core (@distube/ytdl-core) sudah tidak bisa membacakan format YouTube,
# jadi jalur utama adalah yt-dlp. Set true hanya kalau mau mencoba ytdl-core dulu:
# USE_YTDLCORE=true

ROBLOX_POLL_OPERATION=true
ROBLOX_POLL_ATTEMPTS=12
ROBLOX_POLL_INTERVAL_MS=1500
ROBLOX_ASSET_PERMISSIONS_URL_TEMPLATE=https://apis.roblox.com/assets/v1/assets/{assetId}/permissions
COLLAB_PERMISSION_RETRY_ON_404=true
COLLAB_PERMISSION_RETRY_ATTEMPTS=8
COLLAB_PERMISSION_RETRY_INTERVAL_MS=2500

# Untuk akses frontend dari domain Netlify / localhost
# Deployment Railway: biarkan kosong, frontend (dist) dan API dilayani satu server.
CORS_ALLOW_ORIGINS=*
# Contoh lebih aman:
# CORS_ALLOW_ORIGINS=https://lolbeloxsound.netlify.app,http://localhost:5173

# Telegram bot (removed/disabled in this repo)
# If you re-enable Telegram integration, uncomment and fill these as needed:
# TELEGRAM_BOT_TOKEN=isi_token_bot_dari_botfather
# ROBLOX_BACKEND_BASE_URL=http://127.0.0.1:8787/api/roblox
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_ADMIN_USER_IDS=123456789
# TELEGRAM_ACCESS_STORE_FILE=telegram_bot/access_store.json
# TELEGRAM_EVENT_LOG_LIMIT=2000
# TELEGRAM_FREE_MAX_UPLOADS_PER_WEEK=5
